# Ключ API Anthropic — необязателен. Учитель вводит свой ключ прямо на
# странице (иконка «Настройки»), он хранится в его браузере и присылается
# с каждым запросом. Эту переменную можно задать только если вы хотите
# держать один общий серверный ключ для всех вместо ввода на странице.
ANTHROPIC_API_KEY=

# Модель Claude, используемая для генерации (можно не менять)
ANTHROPIC_MODEL=claude-sonnet-5

# Список разрешённых доменов для CORS через запятую.
# Оставьте пустым, если фронтенд и API работают на одном домене (стандартный случай на Vercel).
ALLOWED_ORIGINS=

# Порт для локального запуска через server.js (на Vercel не используется)
PORT=3000

# production | development
NODE_ENV=production
